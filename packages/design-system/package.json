{
    "name": "@lar-works/design-system",
    "version": "0.7.2",
    "description": "Lar's design system: tokens, base styles, generic components and patterns, and the building blocks for an app's own UI layer.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maddec01/lar-web.git",
        "directory": "packages/design-system"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./primitives": {
            "types": "./dist/primitives.d.ts",
            "default": "./dist/primitives.js"
        },
        "./icons": {
            "types": "./dist/icons.d.ts",
            "default": "./dist/icons.js"
        },
        "./icons/dynamic": {
            "types": "./dist/icons/dynamic.d.ts",
            "default": "./dist/icons/dynamic.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./styles.css": "./src/styles.css"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.stories.tsx"
    ],
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vp test run",
        "test:browser": "vp test run --project chromium",
        "storybook": "storybook dev --port 6006",
        "build-storybook": "storybook build --output-dir storybook-static"
    },
    "dependencies": {
        "@lexical/code": "0.52.0",
        "@lexical/html": "0.52.0",
        "@lexical/link": "0.52.0",
        "@lexical/list": "0.52.0",
        "@lexical/markdown": "0.52.0",
        "@lexical/react": "0.53.0",
        "@lexical/rich-text": "0.52.0",
        "@lexical/selection": "0.52.0",
        "@ninna-ui/core": "^0.7.0",
        "@ninna-ui/feedback": "^0.7.0",
        "@ninna-ui/forms": "^0.7.0",
        "@ninna-ui/layout": "^0.7.0",
        "@ninna-ui/overlays": "^0.7.0",
        "@ninna-ui/primitives": "^0.7.0",
        "@ninna-ui/react-internal": "^0.7.0",
        "@tanstack/react-virtual": "^3.14.26",
        "hast-util-to-jsx-runtime": "^2.3.7",
        "html-tag-names": "^2.1.0",
        "lexical": "0.52.0",
        "lucide-react": "^1.70.0",
        "qrcode-generator": "^2.0.4",
        "react-markdown": "^10.1.0",
        "rehype-parse": "^9.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "unified": "^11.0.5"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.0"
    },
    "devDependencies": {
        "@lar-works/config": "workspace:*",
        "@storybook/addon-a11y": "10.6.6",
        "@storybook/addon-docs": "10.6.6",
        "@storybook/addon-themes": "10.6.6",
        "@storybook/react-vite": "10.6.6",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/hast": "^3.0.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/browser-playwright": "5.1.0",
        "jsdom": "^30.1.3",
        "playwright": "1.56.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "storybook": "10.6.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "vite-plus": "1.5.0"
    }
}
