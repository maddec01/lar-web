{
    "name": "@lar-works/design-system",
    "version": "0.2.1",
    "description": "Lar's design system: tokens, base styles and every visual component the Lar web apps use.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maddec01/lar-web.git",
        "directory": "packages/design-system"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./icons": {
            "types": "./dist/icons.d.ts",
            "default": "./dist/icons.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./styles.css": "./src/styles.css",
        "./showcase.css": "./src/showcase.css"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.tsx",
        "!src/**/*.stories.tsx"
    ],
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vp test run",
        "storybook": "storybook dev --port 6006",
        "build-storybook": "storybook build --output-dir storybook-static"
    },
    "dependencies": {
        "@ninna-ui/core": "^0.6.0",
        "@ninna-ui/feedback": "^0.6.0",
        "@ninna-ui/forms": "^0.6.0",
        "@ninna-ui/layout": "^0.6.0",
        "@ninna-ui/overlays": "^0.6.0",
        "@ninna-ui/primitives": "^0.6.0",
        "@ninna-ui/react-internal": "^0.6.0",
        "@tanstack/react-virtual": "^3.14.26",
        "lucide-react": "^1.70.0",
        "qrcode-generator": "^2.0.4"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.0"
    },
    "devDependencies": {
        "@lar-works/config": "workspace:*",
        "@storybook/addon-a11y": "10.6.6",
        "@storybook/addon-docs": "10.6.6",
        "@storybook/addon-themes": "10.6.6",
        "@storybook/react-vite": "10.6.6",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "jsdom": "^30.1.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "storybook": "10.6.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "vite-plus": "1.5.0"
    }
}
